# Configuration. `./scripts/setup.sh` copies this to .env and generates the secrets.
# docker compose: infrastructure hostnames are set in docker-compose.yml; this file supplies
# secrets, API keys and options. Running binaries on the host: the localhost URLs below apply.
# development | test | production (production enforces secrets and safe settings)
APP_ENV=development
SERVICE_NAME=newsintel
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080
# comma-separated; empty disables CORS
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=info

# --- PostgreSQL (source of truth; no pgvector) ---
DATABASE_URL=postgres://newsintel:newsintel@localhost:5432/newsintel?sslmode=disable
DB_MAX_CONNS=20

# --- Secrets (required in production; set them in development too so API and worker agree) ---
# base64 >= 32 bytes; encrypts provider API keys and device tokens (AES-GCM)
SECRETS_ENCRYPTION_KEY=
# base64 >= 32 bytes; HMAC for OTP codes and device-token lookup hashes
AUTH_CODE_HMAC_SECRET=
# kid:base64(32-byte Ed25519 seed)[,kid2:seed2]; empty in dev = ephemeral key
AUTH_SIGNING_KEYS=
AUTH_ACTIVE_KEY_ID=
AUTH_ISSUER=newsintel
AUTH_AUDIENCE=newsintel-api
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
AUTH_CODE_TTL=10m
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_RESEND_MIN_INTERVAL=60s
AUTH_RESEND_HOURLY_CAP=5

# --- Messaging: postgres (outbox + SKIP LOCKED queue) or kafka ---
BUS_DRIVER=postgres
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=newsintel

# --- Search (empty = degraded fallbacks: PostgreSQL FTS and in-memory vectors, reported in responses) ---
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX_PREFIX=newsintel
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_PREFIX=newsintel_

# --- Cache / rate limits ---
# empty = in-process limiter (single instance only)
REDIS_URL=redis://localhost:6379/0

# --- Object storage: filesystem or s3 (SeaweedFS in docker compose; any S3-compatible store) ---
STORAGE_DRIVER=filesystem
STORAGE_DIR=./var/storage
S3_ENDPOINT=localhost:8333
S3_ACCESS_KEY=newsintel
S3_SECRET_KEY=newsintel-dev-secret
S3_BUCKET=newsintel
S3_USE_SSL=false
# Address clients use for presigned download URLs (empty: S3_ENDPOINT)
S3_PUBLIC_ENDPOINT=
STORAGE_URL_TTL=5m

# --- Email: devsink (stored in DB, readable at GET /v1/dev/mailbox) or smtp (Mailpit locally on :1025, UI :8025) ---
MAIL_DRIVER=devsink
MAIL_FROM="News Intelligence <no-reply@localhost>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=

# --- Push notifications: none | apns,fcm (missing credentials => deliveries recorded as provider_unavailable) ---
PUSH_DRIVER=none
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_KEY_PEM=
APNS_PRODUCTION=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# --- AI providers: keys are referenced by name from the AI registry (admin API); remote providers are seeded disabled ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Crawling ---
CRAWL_USER_AGENT="NewsIntelBot/0.1 (+https://example.invalid/bot; contact: ops@example.invalid)"
# scheduled live HTTP crawling; fixtures work without it
CRAWL_LIVE_ENABLED=false
# never true in production
CRAWL_ALLOW_PRIVATE_NETWORKS=false
FIXTURE_DIR=./fixtures
# dev/test: shift fixture dates relative to now (e.g. 2026-10-14T01:00:00+03:00)
FIXTURE_TIME_ANCHOR=

# --- Workers ---
WORKER_CONCURRENCY=4
SCHEDULER_INTERVAL=15s
WORKER_METRICS_ADDR=:9091

# --- Observability / analytics (optional) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
# postgres | clickhouse
ANALYTICS_DRIVER=postgres
CLICKHOUSE_URL=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- First administrator (created by the compose init step / `newsctl create-admin`) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

# --- Verified ordinary account for testing the apps and the web console (created by init) ---
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_PHONE=

# --- Load the SYNTHETIC demo sources on first start (fixtures/sources.json) ---
SEED_FIXTURES=true

# --- Python ML service (services/ml) ---
# Host runs: point the Go seed at it (compose sets http://ml:8000 itself).
ML_SERVICE_URL=
# fastembed (ONNX, default) | sentence_transformers | hash (deterministic, tests/offline only)
ML_EMBEDDING_BACKEND=fastembed
ML_EMBEDDING_MODEL=BAAI/bge-m3
ML_EMBEDDING_DIMS=1024
# fastembed | sentence_transformers | embedding (cosine on the embedding model) | none
ML_RERANK_BACKEND=fastembed
ML_RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual
# Optional bearer token for the ML API (Go reads it through the provider's api_key_env)
ML_API_KEY=
# Optional Hugging Face token for gated/rate-limited model downloads
HF_TOKEN=
