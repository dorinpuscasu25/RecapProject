# Local development configuration. Copy to .env and adjust; never commit real secrets.
# Generate secrets with:  openssl rand -base64 32
APP_ENV=development                    # development | test | production (production enforces secrets and safe settings)
SERVICE_NAME=newsintel
HTTP_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=                  # comma-separated; empty disables CORS
LOG_LEVEL=info

# --- PostgreSQL (source of truth; no pgvector) ---
DATABASE_URL=postgres://newsintel:newsintel@localhost:5432/newsintel?sslmode=disable
DB_MAX_CONNS=20

# --- Secrets (required in production; set them in development too so API and worker agree) ---
SECRETS_ENCRYPTION_KEY=                # base64 >= 32 bytes; encrypts provider API keys and device tokens (AES-GCM)
AUTH_CODE_HMAC_SECRET=                 # base64 >= 32 bytes; HMAC for OTP codes and device-token lookup hashes
AUTH_SIGNING_KEYS=                     # kid:base64(32-byte Ed25519 seed)[,kid2:seed2]; empty in dev = ephemeral key
AUTH_ACTIVE_KEY_ID=
AUTH_ISSUER=newsintel
AUTH_AUDIENCE=newsintel-api
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h
AUTH_CODE_TTL=10m
AUTH_CODE_MAX_ATTEMPTS=5
AUTH_RESEND_MIN_INTERVAL=60s
AUTH_RESEND_HOURLY_CAP=5

# --- Messaging: postgres (outbox + SKIP LOCKED queue) or kafka ---
BUS_DRIVER=postgres
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=newsintel

# --- Search (empty = degraded fallbacks: PostgreSQL FTS and in-memory vectors, reported in responses) ---
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX_PREFIX=newsintel
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_PREFIX=newsintel_

# --- Cache / rate limits ---
REDIS_URL=redis://localhost:6379/0     # empty = in-process limiter (single instance only)

# --- Object storage: filesystem or s3 (MinIO locally) ---
STORAGE_DRIVER=filesystem
STORAGE_DIR=./var/storage
S3_ENDPOINT=localhost:9000
S3_ACCESS_KEY=newsintel
S3_SECRET_KEY=newsintel-dev-secret
S3_BUCKET=newsintel
S3_USE_SSL=false
STORAGE_URL_TTL=5m

# --- Email: devsink (stored in DB, readable at GET /v1/dev/mailbox) or smtp (Mailpit locally on :1025, UI :8025) ---
MAIL_DRIVER=devsink
MAIL_FROM="News Intelligence <no-reply@localhost>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=

# --- Push notifications: none | apns,fcm (missing credentials => deliveries recorded as provider_unavailable) ---
PUSH_DRIVER=none
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_KEY_PEM=
APNS_PRODUCTION=false
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=

# --- AI providers: keys are referenced by name from the AI registry (admin API); remote providers are seeded disabled ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Crawling ---
CRAWL_USER_AGENT="NewsIntelBot/0.1 (+https://example.invalid/bot; contact: ops@example.invalid)"
CRAWL_LIVE_ENABLED=false               # scheduled live HTTP crawling; fixtures work without it
CRAWL_ALLOW_PRIVATE_NETWORKS=false     # never true in production
FIXTURE_DIR=./fixtures
FIXTURE_TIME_ANCHOR=                   # dev/test: shift fixture dates relative to now (e.g. 2026-10-14T01:00:00+03:00)

# --- Workers ---
WORKER_CONCURRENCY=4
SCHEDULER_INTERVAL=15s
WORKER_METRICS_ADDR=:9091

# --- Observability / analytics (optional) ---
OTEL_EXPORTER_OTLP_ENDPOINT=
ANALYTICS_DRIVER=postgres              # postgres | clickhouse
CLICKHOUSE_URL=
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
